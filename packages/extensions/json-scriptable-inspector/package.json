{
  "package_version": 2,
  "version": "1.0.0",
  "name": "json-scriptable-inspector",
  "description": "ScriptableObject-style Visual JSON Inspector with direct Save capabilities for Cocos Creator 3.8",
  "main": "./main.js",
  "author": "cc_playable_framework",
  "editor": ">=3.7.0",
  "contributions": {
    "inspector": {
      "section": {
        "asset": {
          "json": "./inspector.js",
          "cc.JsonAsset": "./inspector.js"
        }
      }
    },
    "messages": {
      "save-json-asset": {
        "methods": ["saveJsonAsset"]
      },
      "read-json-asset": {
        "methods": ["readJsonAsset"]
      }
    }
  }
}
