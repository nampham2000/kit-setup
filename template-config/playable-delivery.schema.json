{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://playable-shared-kit.local/playable-delivery.schema.json",
  "title": "Playable Delivery Pipeline",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "jobs", "hubs", "delivery"],
  "properties": {
    "$schema": { "type": "string" },
    "schemaVersion": { "const": 1 },
    "jobs": {
      "type": "integer",
      "minimum": 1,
      "description": "Maximum number of parallel Cocos build workers."
    },
    "hubs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "briefs"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9_-]*$" },
          "title": { "type": "string", "minLength": 1 },
          "subtitle": { "type": "string", "minLength": 1 },
          "out": { "type": "string", "minLength": 1 },
          "briefs": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": { "type": "string", "pattern": "^[a-z0-9][a-z0-9_-]*$" }
          }
        }
      }
    },
    "delivery": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provider", "siteDir"],
      "properties": {
        "provider": { "enum": ["none", "netlify", "github-pages"] },
        "siteDir": { "type": "string", "minLength": 1 },
        "netlify": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "siteIdEnv": { "type": "string", "pattern": "^[A-Z_][A-Z0-9_]*$" }
          }
        },
        "githubPages": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "branch": { "type": "string", "minLength": 1 }
          }
        }
      }
    }
  }
}
