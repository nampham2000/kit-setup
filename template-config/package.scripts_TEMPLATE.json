    "stats:doctor": "node playable-shared-kit/tools/resource-stats.cjs --doctor",
    "playbook": "node -e \"const {exec}=require('child_process'); exec(process.platform==='win32'?'start docs/playbook/index.html':(process.platform==='darwin'?'open docs/playbook/index.html':'xdg-open docs/playbook/index.html'))\""
