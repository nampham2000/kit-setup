    "deploy:netlify": "node playable-shared-kit/tools/deploy-preview.cjs --provider netlify",
    "deploy:vercel": "node playable-shared-kit/tools/deploy-preview.cjs --provider vercel",
    "deploy:all": "node playable-shared-kit/tools/deploy-preview.cjs --provider all",
    "deploy:build": "node playable-shared-kit/tools/deploy-preview.cjs --build",
