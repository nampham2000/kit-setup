// ParticleSystem-compatible Cocos port of Unity TCP2 "Hybrid Shader 2".
CCEffect %{
  temporaries:
    p1: &p1
      mainTexture: { value: white }
      mainTiling_Offset: { value: [1, 1, 0, 0] }
      mainColor: { value: [1, 1, 1, 1], linear: true, editor: { type: color } }
      highlightColor: { value: [1, 1, 1, 1], linear: true, editor: { type: color } }
      shadowColor: { value: [0.2, 0.2, 0.2, 1], linear: true, editor: { type: color } }
      rampThreshold: { value: 0.75, target: toonParams.x }
      rampSmoothing: { value: 0.1, target: toonParams.y }
      indirectStrength: { value: 1, target: toonParams.z }
      shadowLightAtten: { value: 1, target: toonParams.w }
      rimColor: { value: [0.8, 0.8, 0.8, 1], linear: true, editor: { type: color } }
      rimMin: { value: 0.5, target: rimParams.x }
      rimMax: { value: 1, target: rimParams.y }
      rimLightMask: { value: 1, target: rimParams.z }
      rimStrength: { value: 1, target: rimParams.w }
      specularColor: { value: [0.75, 0.75, 0.75, 1], linear: true, editor: { type: color } }
      specularRoughness: { value: 0.5, target: specularParams.x }
      specularStrength: { value: 0, target: specularParams.y }
      emissive: { value: [0, 0, 0, 1], linear: true, editor: { type: color } }
    d1: &d1 { depthTest: true, depthWrite: true }
    d2: &d2 { depthTest: true, depthWrite: false }
    r1: &r1 { cullMode: back }
    b1: &b1
      targets:
      - blend: true
        blendSrc: src_alpha
        blendDst: one_minus_src_alpha
        blendSrcAlpha: one
        blendDstAlpha: one_minus_src_alpha

  techniques:
  - name: opaque
    passes:
    - vert: tcp2-particle-vs:vert
      frag: tcp2-particle-fs:frag
      rasterizerState: *r1
      depthStencilState: *d1
      properties: *p1
    - vert: tcp2-particle-vs:vert
      frag: tcp2-particle-fs:frag
      phase: deferred-forward
      rasterizerState: *r1
      depthStencilState: *d1
      propertyIndex: 0
  - name: alpha-blend
    passes:
    - vert: tcp2-particle-vs:vert
      frag: tcp2-particle-fs:frag
      rasterizerState: *r1
      depthStencilState: *d2
      blendState: *b1
      properties: *p1
    - vert: tcp2-particle-vs:vert
      frag: tcp2-particle-fs:frag
      phase: deferred-forward
      rasterizerState: *r1
      depthStencilState: *d2
      blendState: *b1
      propertyIndex: 0
}%

CCProgram tcp2-particle-shared %{
  uniform TCP2ParticleParams {
    vec4 mainColor;
    vec4 highlightColor;
    vec4 shadowColor;
    vec4 toonParams;
    vec4 rimColor;
    vec4 rimParams;
    vec4 specularColor;
    vec4 specularParams;
    vec4 emissive;
  };
}%

CCProgram tcp2-particle-vs %{
  precision highp float;

  #include <common/math/transform>
  #include <builtin/internal/particle-common>
  #include <builtin/uniforms/cc-local>

  in vec3 a_texCoord1;
  in vec3 a_texCoord2;
  in vec4 a_color;
  in vec3 a_texCoord;
  #if !CC_INSTANCE_PARTICLE
    in vec3 a_position;
  #endif
  #if CC_INSTANCE_PARTICLE
    in vec4 a_texCoord4;
  #endif
  #if CC_RENDER_MODE == RENDER_MODE_STRETCHED_BILLBOARD
    in vec3 a_color1;
  #endif
  #if CC_RENDER_MODE == RENDER_MODE_MESH
    in vec3 a_texCoord3;
    in vec3 a_normal;
    in vec4 a_color1;
  #endif

  out highp vec3 v_worldPosition;
  out mediump vec3 v_worldNormal;

  vec4 vert () {
    vec3 compScale = scale.xyz * a_texCoord1;
    #if !CC_INSTANCE_PARTICLE
      vec4 pos = vec4(a_position.xyz, 1.0);
    #endif
    #if CC_INSTANCE_PARTICLE
      vec4 pos = vec4(a_texCoord4.xyz, 1.0);
    #endif
    #if CC_RENDER_MODE == RENDER_MODE_STRETCHED_BILLBOARD
      vec4 velocity = vec4(a_color1.xyz, 0.0);
    #endif

    #if !CC_USE_WORLD_SPACE
      pos = cc_matWorld * pos;
      #if CC_RENDER_MODE == RENDER_MODE_STRETCHED_BILLBOARD
        velocity = cc_matWorld * velocity;
      #endif
    #endif

    #pragma define INDENTIFY_NEG_QUAT 10.0
    #if ROTATION_OVER_TIME_MODULE_ENABLE
      vec3 rotTmp = a_texCoord2;
      float mulFactor = 1.0;
      if (rotTmp.x > INDENTIFY_NEG_QUAT * 0.5) {
        rotTmp.x -= INDENTIFY_NEG_QUAT;
        mulFactor = -1.0;
      }
      vec4 rot = vec4(rotTmp, 0.0);
      rot.w = mulFactor * sqrt(abs(1.0 - dot(rot.xyz, rot.xyz)));
    #else
      #if CC_RENDER_MODE == RENDER_MODE_BILLBOARD
        vec3 rotEuler = a_texCoord2;
      #elif CC_RENDER_MODE == RENDER_MODE_STRETCHED_BILLBOARD
        vec3 rotEuler = vec3(0.0);
      #elif CC_RENDER_MODE == RENDER_MODE_MESH
        vec3 rotEuler = a_texCoord2;
      #else
        vec3 rotEuler = vec3(0.0, 0.0, a_texCoord2.z);
      #endif
      vec4 rot = quaternionFromEuler(rotEuler);
    #endif

    #if CC_RENDER_MODE != RENDER_MODE_MESH
      vec2 cornerOffset = a_texCoord.xy - 0.5;
      #if CC_RENDER_MODE == RENDER_MODE_BILLBOARD || CC_RENDER_MODE == RENDER_MODE_VERTICAL_BILLBOARD
        computeVertPos(pos, cornerOffset, rot, compScale, cc_matViewInv);
      #elif CC_RENDER_MODE == RENDER_MODE_STRETCHED_BILLBOARD
        computeVertPos(pos, cornerOffset, rot, compScale, cc_cameraPos.xyz, velocity, frameTile_velLenScale.z, frameTile_velLenScale.w, a_texCoord.x);
      #elif CC_RENDER_MODE == RENDER_MODE_HORIZONTAL_BILLBOARD
        computeVertPos(pos, cornerOffset, rot, compScale);
      #endif
      color = a_color;
      v_worldNormal = normalize(cc_cameraPos.xyz - pos.xyz);
    #else
      mat3 rotMat = quatToMat3(rot);
      mat3 nodeMat = quatToMat3(nodeRotation);
      rot = mat3ToQuat(nodeMat * rotMat);
      mat4 xformNoScale = matrixFromRT(rot, pos.xyz);
      mat4 xform = matFromRTS(rot, pos.xyz, compScale);
      pos = xform * vec4(a_texCoord3, 1.0);
      v_worldNormal = normalize((xformNoScale * vec4(a_normal, 0.0)).xyz);
      color = a_color * a_color1;
    #endif

    #if !CC_INSTANCE_PARTICLE
      uv = computeUV(a_texCoord.z, a_texCoord.xy, frameTile_velLenScale.xy) * mainTiling_Offset.xy + mainTiling_Offset.zw;
    #else
      uv = computeUV(a_texCoord4.w, a_texCoord.xy, frameTile_velLenScale.xy) * mainTiling_Offset.xy + mainTiling_Offset.zw;
    #endif

    v_worldPosition = pos.xyz;
    return cc_matViewProj * pos;
  }
}%

CCProgram tcp2-particle-fs %{
  precision highp float;

  #include <legacy/output>
  #include <common/color/gamma>
  #include <builtin/internal/embedded-alpha>
  #include <builtin/uniforms/cc-global>
  #include <tcp2-particle-shared>

  in mediump vec2 uv;
  in mediump vec4 color;
  in highp vec3 v_worldPosition;
  in mediump vec3 v_worldNormal;

  uniform sampler2D mainTexture;

  float ggxDistribution (float noH, float roughness) {
    float alpha = max(roughness * roughness, 0.001);
    float alpha2 = alpha * alpha;
    float denominator = noH * noH * (alpha2 - 1.0) + 1.0;
    return alpha2 / max(3.14159265 * denominator * denominator, 0.0001);
  }

  vec4 frag () {
    vec4 texColor = CCSampleWithAlphaSeparated(mainTexture, uv);
    texColor.rgb = SRGBToLinear(texColor.rgb);
    vec4 baseColor = texColor * color * mainColor;

    vec3 normal = normalize(v_worldNormal);
    vec3 lightDirection = normalize(-cc_mainLitDir.xyz);
    vec3 viewDirection = normalize(cc_cameraPos.xyz - v_worldPosition);
    vec3 halfDirection = normalize(lightDirection + viewDirection);
    float noL = max(dot(normal, lightDirection), 0.0);
    float noV = max(dot(normal, viewDirection), 0.0001);
    float noH = max(dot(normal, halfDirection), 0.0);
    float halfLambert = dot(normal, lightDirection) * 0.5 + 0.5;
    float halfWidth = max(toonParams.y * 0.5, 0.0001);
    float ramp = smoothstep(toonParams.x - halfWidth, toonParams.x + halfWidth, halfLambert);

    vec3 mainLight = cc_mainLitColor.rgb * cc_mainLitColor.w;
    vec3 toonTint = mix(shadowColor.rgb, highlightColor.rgb, ramp);
    vec3 direct = baseColor.rgb * toonTint * mix(vec3(1.0), mainLight, toonParams.w);
    float hemisphere = normal.y * 0.5 + 0.5;
    vec3 ambient = mix(cc_ambientGround.rgb, cc_ambientSky.rgb, hemisphere) * cc_ambientSky.w;
    vec3 indirect = baseColor.rgb * ambient * toonParams.z;

    float rim = smoothstep(rimParams.x, max(rimParams.y, rimParams.x + 0.0001), 1.0 - noV);
    vec3 rimContribution = rimColor.rgb * rim * mix(vec3(1.0), mainLight * ramp, rimParams.z) * rimParams.w;
    vec3 specular = ggxDistribution(noH, specularParams.x) * specularColor.rgb * mainLight * noL * specularParams.y;
    return CCFragOutput(vec4(direct + indirect + rimContribution + specular + emissive.rgb, baseColor.a));
  }
}%
