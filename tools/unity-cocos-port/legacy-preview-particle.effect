// Cocos port of the LegacyPreviewCompatibility URP shims
// (Assets/LegacyPreviewCompatibility/LegacyPreviewURP.shader):
//   OPAQUE pass: tex(_MainTex) * _Color     * vertex color, opaque, ZWrite On, Cull Back
//   EFFECT pass: tex(_MainTex) * _TintColor * vertex color, Blend SrcAlpha OneMinusSrcAlpha,
//                ZWrite Off, Cull Off
// unityColor holds the serialized ShaderLab color; unityColorSpace flags which
// inputs Unity linearizes in a Linear project (x texture, y vertex color,
// z color property, w project is linear). UNITY_LINEAR_OUTPUT leaves the result
// linear for a Unity-style linear frame; otherwise a linear project is encoded
// to sRGB here, which is exact only for opaque output.
CCEffect %{
  temporaries:
    blendEffect: &blendEffect
      targets:
      - blend: true
        blendSrc: src_alpha
        blendDst: one_minus_src_alpha
        blendSrcAlpha: src_alpha
        blendDstAlpha: one_minus_src_alpha
    depthEffect: &depthEffect { depthTest: true, depthWrite: false }
    cullNone: &cullNone { cullMode: none }
    meshProps: &meshProps
      mainTexture:        { value: white }
      mainTiling_Offset:  { value: [1, 1, 0, 0] }
      unityColor:         { value: [1, 1, 1, 1], editor: { type: vector } }
      unityColorSpace:    { value: [0, 0, 0, 0], editor: { type: vector } }
    particleProps: &particleProps
      <<: *meshProps
      sourceRendererPivot: { value: [0, 0, 0, 0] }
      sourceRendererSize: { value: [0, 0.5, 0, 0] }
      sourceRendererMesh: { value: [0, 0, 0, 0] }
  techniques:
  - name: mesh-opaque
    passes:
    - vert: legacy-preview-mesh-vs:vert
      frag: legacy-preview-fs:frag
      properties: *meshProps
  - name: mesh-effect
    passes:
    - vert: legacy-preview-mesh-vs:vert
      frag: legacy-preview-fs:frag
      rasterizerState: *cullNone
      depthStencilState: *depthEffect
      blendState: *blendEffect
      properties: *meshProps
  - name: particle-effect
    passes:
    - vert: source-particle-vs:lpvs_main
      frag: legacy-preview-fs:frag
      rasterizerState: *cullNone
      depthStencilState: *depthEffect
      blendState: *blendEffect
      properties: *particleProps
  - name: particle-opaque
    passes:
    - vert: source-particle-vs:lpvs_main
      frag: legacy-preview-fs:frag
      properties: *particleProps
}%

CCProgram legacy-preview-mesh-vs %{
  precision highp float;
  #include <legacy/input>
  #include <builtin/uniforms/cc-global>
  #include <legacy/decode-base>
  #include <legacy/local-batch>

  #if USE_VERTEX_COLOR
    in lowp vec4 a_color;
  #endif
  out vec2 uv;
  out vec4 color;
  uniform LegacyPreviewMesh {
    vec4 mainTiling_Offset;
  };

  vec4 vert () {
    vec4 position;
    CCVertInput(position);
    mat4 matWorld;
    CCGetWorldMatrix(matWorld);
    uv = a_texCoord * mainTiling_Offset.xy + mainTiling_Offset.zw;
    #if USE_VERTEX_COLOR
      color = a_color;
    #else
      color = vec4(1.0);
    #endif
    return cc_matProj * (cc_matView * matWorld) * position;
  }
}%

CCProgram legacy-preview-fs %{
  precision highp float;
  in vec2 uv;
  in vec4 color;
  uniform sampler2D mainTexture;
  uniform LegacyPreviewFragment {
    vec4 unityColor;
    vec4 unityColorSpace;
  };

  vec3 legacyToLinear (vec3 c) {
    return mix(c / 12.92, pow((c + 0.055) / 1.055, vec3(2.4)), step(vec3(0.04045), c));
  }
  vec3 legacyToSrgb (vec3 c) {
    c = max(c, vec3(0.0));
    return mix(c * 12.92, 1.055 * pow(c, vec3(1.0 / 2.4)) - 0.055, step(vec3(0.0031308), c));
  }

  vec4 frag () {
    vec4 tex = texture(mainTexture, uv);
    if (unityColorSpace.x > 0.5) tex.rgb = legacyToLinear(tex.rgb);
    vec4 vertexColor = color;
    if (unityColorSpace.y > 0.5) vertexColor.rgb = legacyToLinear(vertexColor.rgb);
    vec4 materialColor = unityColor;
    if (unityColorSpace.z > 0.5) materialColor.rgb = legacyToLinear(materialColor.rgb);
    vec4 o = tex * materialColor * vertexColor;
    #if !UNITY_LINEAR_OUTPUT
      if (unityColorSpace.w > 0.5) o.rgb = legacyToSrgb(o.rgb);
    #endif
    return o;
  }
}%

// Adapted from Cocos Creator 3.8.8 (MIT, Xiamen Yaji Software).
CCProgram source-particle-vs %{

precision highp float;
#include <common/math/transform>
#include <builtin/internal/particle-common>
#include <builtin/uniforms/cc-local>

in vec3 a_texCoord1;  // size
in vec3 a_texCoord2;  // rotation
in vec4 a_color;

in vec3 a_texCoord;  // xy:vertex index,z:frame index
#if !CC_INSTANCE_PARTICLE
 in vec3 a_position;  // center position
#endif
#if CC_INSTANCE_PARTICLE
 in vec4 a_texCoord4; // xyz:position,z:frame index
#endif

#if CC_RENDER_MODE == RENDER_MODE_STRETCHED_BILLBOARD
  in vec3 a_color1; // velocity.x, velocity.y, velocity.z, scale
#endif

#if CC_RENDER_MODE == RENDER_MODE_MESH
  in vec3 a_texCoord3;  // mesh vertices
  in vec3 a_normal;     // mesh normal
  in vec4 a_color1;     // mesh color
#endif

uniform SourceRenderer { vec4 sourceRendererPivot; vec4 sourceRendererSize; vec4 sourceRendererMesh; };
vec4 sourceEuler(vec3 e) {
  vec3 s=sin(e*0.5),c=cos(e*0.5);
  return vec4(s.x*c.y*c.z+c.x*s.y*s.z,
              c.x*s.y*c.z-s.x*c.y*s.z,
              c.x*c.y*s.z-s.x*s.y*c.z,
              c.x*c.y*c.z+s.x*s.y*s.z);
}
// Unity ParticleSystemRenderer.minParticleSize/maxParticleSize (BakeMesh):
// max(size.x, size.y) is clamped to x/y times the viewport WIDTH in world
// units at the particle's view depth (clip w; 1 for orthographic cameras).
// w=1 enables the clamp; the property default w=0 keeps older materials.
float sourceSizeFactor(vec3 center, vec3 s) {
  float width = 2.0 * (cc_matViewProj * vec4(center, 1.0)).w / abs(cc_matProj[0][0]);
  float m = max(max(s.x, s.y), 1e-6);
  return sourceRendererSize.w < 0.5 ? 1.0 : min(max(m, sourceRendererSize.x * width), sourceRendererSize.y * width) / m;
}
vec4 lpvs_main () {
  vec3 compScale = scale.xyz * a_texCoord1;
  #if !CC_INSTANCE_PARTICLE
    vec4 pos = vec4(a_position.xyz, 1);
  #endif
  #if CC_INSTANCE_PARTICLE
    vec4 pos = vec4(a_texCoord4.xyz, 1);
  #endif
  #if CC_RENDER_MODE == RENDER_MODE_STRETCHED_BILLBOARD
    vec4 velocity = vec4(a_color1.xyz, 0);
  #endif

  #if !CC_USE_WORLD_SPACE
    // simulate in world space. apply cc_matWorld matrix on CPU side.
    pos = cc_matWorld * pos;
    #if CC_RENDER_MODE == RENDER_MODE_STRETCHED_BILLBOARD
      velocity = cc_matWorld * velocity;
    #endif
  #endif

  #if CC_RENDER_MODE == RENDER_MODE_STRETCHED_BILLBOARD
    compScale.x *= sourceSizeFactor(pos.xyz, compScale); // length stays unclamped
  #elif CC_RENDER_MODE != RENDER_MODE_MESH
    compScale.xy *= sourceSizeFactor(pos.xyz, compScale);
  #endif

  #pragma define INDENTIFY_NEG_QUAT 10.0

  #if ROTATION_OVER_TIME_MODULE_ENABLE
    vec3 rotTmp = a_texCoord2;
    float mulFactor = 1.0;
    if (rotTmp.x > INDENTIFY_NEG_QUAT * 0.5) {
        rotTmp.x -= INDENTIFY_NEG_QUAT;
        mulFactor = -1.0;
    }
    vec4 rot = vec4(rotTmp, 0.0);
    rot.w = mulFactor * sqrt(abs(1.0 - rot.x * rot.x - rot.y * rot.y - rot.z * rot.z));
  #endif
  #if !ROTATION_OVER_TIME_MODULE_ENABLE
    #if CC_RENDER_MODE != RENDER_MODE_MESH
      #if CC_RENDER_MODE == RENDER_MODE_BILLBOARD
        vec3 rotEuler = a_texCoord2;
      #elif CC_RENDER_MODE == RENDER_MODE_STRETCHED_BILLBOARD
        vec3 rotEuler = vec3(0.);
      #endif
      #if CC_RENDER_MODE != RENDER_MODE_BILLBOARD && CC_RENDER_MODE != RENDER_MODE_STRETCHED_BILLBOARD
        vec3 rotEuler = vec3(0., 0., a_texCoord2.z);
      #endif
      vec4 rot = quaternionFromEuler(rotEuler);
      #if CC_RENDER_MODE == RENDER_MODE_BILLBOARD
        if(sourceRendererPivot.w == 2.0) rot=sourceEuler(rotEuler);
      #endif
    #endif
    #if CC_RENDER_MODE == RENDER_MODE_MESH
      vec4 rot = sourceEuler(a_texCoord2);
    #endif
  #endif

  #if CC_RENDER_MODE != RENDER_MODE_MESH
    vec2 cornerOffset = vec2((a_texCoord.xy - 0.5));
    #if CC_RENDER_MODE == RENDER_MODE_HORIZONTAL_BILLBOARD || CC_RENDER_MODE == RENDER_MODE_VERTICAL_BILLBOARD
      // Unity bakes Horizontal/Vertical billboards with corners at size/2 on
      // the diagonals: the quad side is size/sqrt(2), unlike View billboards.
      compScale.xy *= 0.70710678;
    #endif

    #if CC_RENDER_MODE == RENDER_MODE_BILLBOARD || CC_RENDER_MODE == RENDER_MODE_VERTICAL_BILLBOARD
      #if CC_RENDER_MODE == RENDER_MODE_BILLBOARD
        if(sourceRendererPivot.w == 2.0) {
          vec3 offset=vec3(cornerOffset*compScale.xy,0.0);
          rotateVecFromQuat(offset,rot);
          rotateVecFromQuat(offset,nodeRotation);
          pos.xyz+=offset;
        } else {
          // Unity View billboards (BakeMesh): pivot x/y move the quad by pivot*size in its
          // rotated camera plane; pivot z moves it toward the camera by pivot.z*size.x.
          computeVertPos(pos, cornerOffset + sourceRendererPivot.xy, rot, compScale, cc_matViewInv);
          pos.xyz += normalize(cc_matViewInv[2].xyz) * (sourceRendererPivot.z * compScale.x);
        }
      #else
        computeVertPos(pos, cornerOffset, rot, compScale, cc_matViewInv);
      #endif
    #elif CC_RENDER_MODE == RENDER_MODE_STRETCHED_BILLBOARD
      // Unity bakes a zero-velocity stretched particle as a degenerate quad at
      // its position; normalize(0) would emit NaN vertices instead.
      if (dot(velocity.xyz,velocity.xyz)>0.0) {
        pos.xyz+=normalize(velocity.xyz)*(2.0*compScale.y*sourceRendererPivot.y);
        computeVertPos(pos, cornerOffset, rot, compScale, cc_cameraPos.xyz, velocity, frameTile_velLenScale.z, frameTile_velLenScale.w, a_texCoord.x);
      }
    #elif RENDER_MODE_HORIZONTAL_BILLBOARD
      computeVertPos(pos, cornerOffset, rot, compScale);
    #endif

    color = a_color;
  #endif
  #if CC_RENDER_MODE == RENDER_MODE_MESH
    mat3 rotMat = quatToMat3(rot);
    // w=3: the particle rotation is already world space (Unity World alignment, or the
    // Velocity frame from UnityParticleMeshFrameAdapter); skip the emitter rotation.
    mat3 nodeMat = sourceRendererPivot.w == 3.0 ? mat3(1.0) : quatToMat3(nodeRotation);
    rotMat = nodeMat * rotMat;
    rot = mat3ToQuat(rotMat);

    mat4 xformNoScale = matrixFromRT(rot, pos.xyz);
    mat4 xform = matFromRTS(rot, pos.xyz, compScale);
    // Unity mesh pivot is in mesh-bounds units; sourceRendererMesh.xyz holds the Cocos mesh
    // bounds size (0 until UnityParticleMeshFrameAdapter binds it).
    pos = xform * vec4(a_texCoord3 + sourceRendererPivot.xyz * sourceRendererMesh.xyz, 1);
    vec4 normal = xformNoScale * vec4(a_normal, 0);
    color = a_color * a_color1;
  #endif

  #if !CC_INSTANCE_PARTICLE
    uv = computeUV(a_texCoord.z, a_texCoord.xy, frameTile_velLenScale.xy) * mainTiling_Offset.xy + mainTiling_Offset.zw;
  #endif
  #if CC_INSTANCE_PARTICLE
    uv = computeUV(a_texCoord4.w, a_texCoord.xy, frameTile_velLenScale.xy) * mainTiling_Offset.xy + mainTiling_Offset.zw;
  #endif

  pos = cc_matViewProj * pos;

  return pos;
}

}%
