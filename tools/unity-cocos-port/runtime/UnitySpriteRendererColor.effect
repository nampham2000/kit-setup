CCEffect %{
  techniques:
  - name: transparent
    passes:
    - vert: spriteRender-vs:vert
      frag: spriteRender-fs:frag
      depthStencilState:
        depthTest: true
        depthWrite: false
      blendState:
        targets:
        - blend: true
          blendSrc: src_alpha
          blendDst: one_minus_src_alpha
          blendDstAlpha: one_minus_src_alpha
      rasterizerState:
        cullMode: none
      properties: &props
        mainColor: { value: [1, 1, 1, 1], editor: { type: color } }
  - name: opaque-background
    passes:
    - vert: spriteRender-vs:vert
      frag: spriteRender-fs:frag
      priority: min + 1
      depthStencilState:
        depthTest: true
        depthWrite: true
      rasterizerState:
        cullMode: none
      properties: *props
  - name: smooth-alpha-glow
    passes:
    - vert: spriteRender-vs:vert
      frag: spriteGlow-fs:frag
      depthStencilState:
        depthTest: true
        depthWrite: false
      blendState:
        targets:
        - blend: true
          blendSrc: src_alpha
          blendDst: one_minus_src_alpha
          blendDstAlpha: one_minus_src_alpha
      rasterizerState:
        cullMode: none
      properties: *props
}%

CCProgram spriteRender-vs %{
  precision highp float;
  #include <builtin/uniforms/cc-global>
  #include <builtin/uniforms/cc-local>

  in vec3 a_position;
  in vec2 a_texCoord;

  out vec2 uv0;

  vec4 vert () {
    vec4 pos = vec4(a_position, 1);
    pos = cc_matViewProj * cc_matWorld * pos;
    uv0 = vec2(a_texCoord.x, 1.0 - a_texCoord.y);
    return pos;
  }
}%

CCProgram spriteRender-fs %{
  precision highp float;

  in vec2 uv0;
  #pragma builtin(local)
  layout(set = 2, binding = 12) uniform sampler2D cc_spriteTexture;

  uniform Constant {
    vec4 mainColor;
  };

  vec4 frag () {
    vec4 o = texture(cc_spriteTexture, uv0) * mainColor;
    return o;
  }
}%

CCProgram spriteGlow-fs %{
  precision highp float;

  in vec2 uv0;
  #pragma builtin(local)
  layout(set = 2, binding = 12) uniform sampler2D cc_spriteTexture;

  uniform Constant {
    vec4 mainColor;
  };

  vec4 frag () {
    float alpha = texture(cc_spriteTexture, uv0).a * mainColor.a;
    return vec4(0.29411765, 0.21568627, 0.61568627, alpha);
  }
}%
