// Cocos material-compatible port of Unity Universal Render Pipeline/Unlit.
CCEffect %{
  temporaries:
    p1: &p1
      tilingOffset: { value: [1, 1, 0, 0] }
      mainTexture: { value: white }
      mainColor: { value: [1, 1, 1, 1], linear: true, editor: { type: color } }
      alphaThreshold: { value: 0.5, target: unlitParams.x }
    d1: &d1 { depthTest: true, depthWrite: false }
    b1: &b1
      targets:
      - blend: true
        blendSrc: src_alpha
        blendDst: one_minus_src_alpha
        blendDstAlpha: one_minus_src_alpha

  techniques:
  - name: opaque
    passes:
    - vert: urp-unlit-vs:vert
      frag: urp-unlit-fs:frag
      depthStencilState: { depthTest: true, depthWrite: true }
      properties: *p1
    - vert: urp-unlit-vs:vert
      frag: urp-unlit-fs:frag
      phase: deferred-forward
      propertyIndex: 0
      depthStencilState: { depthTest: true, depthWrite: true }
  - name: transparent
    passes:
    - vert: urp-unlit-vs:vert
      frag: urp-unlit-fs:frag
      depthStencilState: *d1
      blendState: *b1
      properties: *p1
    - vert: urp-unlit-vs:vert
      frag: urp-unlit-fs:frag
      phase: deferred-forward
      propertyIndex: 0
      depthStencilState: *d1
      blendState: *b1
}%

CCProgram urp-unlit-shared %{
  uniform URPUnlitParams {
    vec4 tilingOffset;
    vec4 mainColor;
    vec4 unlitParams;
  };
}%

CCProgram urp-unlit-vs %{
  precision highp float;
  #include <legacy/input>
  #include <builtin/uniforms/cc-global>
  #include <legacy/decode-base>
  #include <legacy/local-batch>
  #include <urp-unlit-shared>

  out vec2 v_uv;

  vec4 vert () {
    vec4 position;
    CCVertInput(position);
    mat4 matWorld, matWorldIT;
    CCGetWorldMatrixFull(matWorld, matWorldIT);
    v_uv = a_texCoord * tilingOffset.xy + tilingOffset.zw;
    return cc_matProj * cc_matView * matWorld * position;
  }
}%

CCProgram urp-unlit-fs %{
  precision highp float;
  #include <legacy/output-standard>
  #include <urp-unlit-shared>

  in vec2 v_uv;
  uniform sampler2D mainTexture;

  // Unity (linear color space) decodes the sRGB _BaseMap on sampling and encodes the result into
  // the 8-bit sRGB target, both with the exact piecewise curves. `legacy/output` never encodes, so
  // linearizing there left the frame dark and oversaturated (texture^2). Cocos' SRGBToLinear /
  // LinearToSRGB are x^2 / sqrt approximations; do Unity's math exactly and round-trip the encoded
  // value through output-standard (SRGBToLinear, then its LinearToSRGB) so 8-bit output is exact.
  vec3 unityDecodeSRGB (vec3 c) {
    return mix(c / 12.92, pow((c + 0.055) / 1.055, vec3(2.4)), step(vec3(0.04045), c));
  }

  vec3 unityEncodeSRGB (vec3 c) {
    c = clamp(c, 0.0, 1.0);
    return mix(c * 12.92, 1.055 * pow(c, vec3(1.0 / 2.4)) - 0.055, step(vec3(0.0031308), c));
  }

  vec4 frag () {
    vec4 color = texture(mainTexture, v_uv);
    color.rgb = unityDecodeSRGB(color.rgb);
    color *= mainColor; // `linear: true` uploads mainColor linearized, like Unity's _BaseColor.
    #if USE_ALPHA_TEST
      if (color.a < unlitParams.x) discard;
    #endif
    return CCFragOutput(vec4(SRGBToLinear(unityEncodeSRGB(color.rgb)), color.a));
  }
}%
