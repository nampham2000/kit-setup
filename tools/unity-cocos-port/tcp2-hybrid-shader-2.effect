// Playable-friendly Cocos mesh port of Unity TCP2 "Hybrid Shader 2".
CCEffect %{
  temporaries:
    p1: &p1
      mainTexture: { value: white }
      emissiveMap: { value: white }
      tilingOffset: { value: [1, 1, 0, 0] }
      mainColor: { value: [1, 1, 1, 1], linear: true, editor: { type: color } }
      highlightColor: { value: [1, 1, 1, 1], linear: true, editor: { type: color } }
      shadowColor: { value: [0.2, 0.2, 0.2, 1], linear: true, editor: { type: color } }
      rampThreshold: { value: 0.75, target: toonParams.x }
      rampSmoothing: { value: 0.1, target: toonParams.y }
      indirectStrength: { value: 1, target: toonParams.z }
      shadowLightAtten: { value: 1, target: toonParams.w }
      rimColor: { value: [0.8, 0.8, 0.8, 1], linear: true, editor: { type: color } }
      rimMin: { value: 0.5, target: rimParams.x }
      rimMax: { value: 1, target: rimParams.y }
      rimLightMask: { value: 1, target: rimParams.z }
      rimStrength: { value: 0, target: rimParams.w }
      specularColor: { value: [0.75, 0.75, 0.75, 1], linear: true, editor: { type: color } }
      specularRoughness: { value: 0.5, target: specularParams.x }
      specularStrength: { value: 0, target: specularParams.y }
      emissive: { value: [0, 0, 0, 1], linear: true, editor: { type: color } }
      recolorStrength: { value: 0, target: recolorParams.x, editor: { range: [0, 1], step: 0.01 } }
      unityLightDirection0: { value: [0, 1, 0, 0] }
      unityLightDirection1: { value: [0, 1, 0, 0] }
      unityLightColor0: { value: [1, 1, 1, 1], linear: true, editor: { type: color } }
      unityLightColor1: { value: [1, 1, 1, 1], linear: true, editor: { type: color } }
      unityLightIntensities: { value: [1, 0, 0, 0] }
      unityAmbientSky: { value: [0, 0, 0, 1], linear: true, editor: { type: color } }
      unityAmbientEquator: { value: [0, 0, 0, 1], linear: true, editor: { type: color } }
      unityAmbientGround: { value: [0, 0, 0, 1], linear: true, editor: { type: color } }
      unityAmbientParams: { value: [1, 0, 0, 0] }
      unitySourceRigParams: { value: [0, 0, 0, 0] }
    d1: &d1 { depthTest: true, depthWrite: true }
    d2: &d2 { depthTest: true, depthWrite: false }
    r1: &r1 { cullMode: back }
    b1: &b1
      targets:
      - blend: true
        blendSrc: src_alpha
        blendDst: one_minus_src_alpha
        blendSrcAlpha: one
        blendDstAlpha: one_minus_src_alpha

  techniques:
  - name: opaque
    passes:
    - vert: tcp2-mesh-vs:vert
      frag: tcp2-mesh-fs:frag
      rasterizerState: *r1
      depthStencilState: *d1
      properties: *p1
    - vert: tcp2-mesh-vs:vert
      frag: tcp2-mesh-fs:frag
      phase: deferred-forward
      rasterizerState: *r1
      depthStencilState: *d1
      propertyIndex: 0
  - name: alpha-blend
    passes:
    - vert: tcp2-mesh-vs:vert
      frag: tcp2-mesh-fs:frag
      rasterizerState: *r1
      depthStencilState: *d2
      blendState: *b1
      properties: *p1
    - vert: tcp2-mesh-vs:vert
      frag: tcp2-mesh-fs:frag
      phase: deferred-forward
      rasterizerState: *r1
      depthStencilState: *d2
      blendState: *b1
      propertyIndex: 0
}%

CCProgram tcp2-mesh-shared %{
  uniform TCP2MeshParams {
    vec4 tilingOffset;
    vec4 mainColor;
    vec4 highlightColor;
    vec4 shadowColor;
    vec4 toonParams;
    vec4 rimColor;
    vec4 rimParams;
    vec4 specularColor;
    vec4 specularParams;
    vec4 emissive;
    vec4 recolorParams;
    vec4 unityLightDirection0;
    vec4 unityLightDirection1;
    vec4 unityLightColor0;
    vec4 unityLightColor1;
    vec4 unityLightIntensities;
    vec4 unityAmbientSky;
    vec4 unityAmbientEquator;
    vec4 unityAmbientGround;
    vec4 unityAmbientParams;
    vec4 unitySourceRigParams;
  };
}%

CCProgram tcp2-mesh-vs %{
  precision highp float;
  #include <legacy/input-standard>
  #include <builtin/uniforms/cc-global>
  #include <legacy/decode-base>
  #include <legacy/local-batch>
  #include <tcp2-mesh-shared>

  out highp vec3 v_worldPosition;
  out mediump vec3 v_worldNormal;
  out vec2 v_uv;

  vec4 vert () {
    StandardVertInput In;
    CCVertInput(In);
    mat4 matWorld, matWorldIT;
    CCGetWorldMatrixFull(matWorld, matWorldIT);
    vec4 worldPosition = matWorld * In.position;
    v_worldPosition = worldPosition.xyz;
    v_worldNormal = normalize((matWorldIT * vec4(In.normal, 0.0)).xyz);
    v_uv = a_texCoord * tilingOffset.xy + tilingOffset.zw;
    return cc_matProj * cc_matView * worldPosition;
  }
}%

CCProgram tcp2-mesh-fs %{
  precision highp float;
  #include <builtin/uniforms/cc-global>
  #include <legacy/output-standard>
  #include <common/color/gamma>
  #include <tcp2-mesh-shared>

  in highp vec3 v_worldPosition;
  in mediump vec3 v_worldNormal;
  in vec2 v_uv;
  uniform sampler2D mainTexture;
  uniform sampler2D emissiveMap;

  // Exact TCP2 Hybrid 2 GGX response. TCP2 squares the authored roughness
  // before passing it to GGX, then applies its 0.05 and linear-color-space
  // surface reduction terms.
  float tcp2Specular (vec3 lightDirection, vec3 viewDirection, vec3 normal) {
    vec3 halfDirection = normalize(lightDirection + viewDirection);
    float noH = max(dot(normal, halfDirection), 0.0);
    float authoredRoughness = max(specularParams.x, 0.00001);
    float roughness = authoredRoughness * authoredRoughness;
    float a2 = roughness * roughness;
    float denominator = (noH * a2 - noH) * noH + 1.0;
    float specular = (1.0 / 3.14159265) * a2
      / max(denominator * denominator + 0.0001, 0.0001);
    specular *= 3.14159265 * 0.05;
    specular *= 1.0 / (roughness * roughness + 1.0);
    return max(specular, 0.0);
  }

  vec3 unityTriLightAmbient (vec3 normal) {
    float up = max(normal.y, 0.0);
    float down = max(-normal.y, 0.0);
    vec3 upper = mix(unityAmbientEquator.rgb, unityAmbientSky.rgb, up);
    vec3 lower = mix(unityAmbientEquator.rgb, unityAmbientGround.rgb, down);
    return (normal.y >= 0.0 ? upper : lower) * unityAmbientParams.x;
  }

  vec4 frag () {
    vec4 baseColor = texture(mainTexture, v_uv);
    // Cocos 3.8.8's own builtin-standard effect explicitly decodes albedo-map
    // samples with SRGBToLinear. Unity imports this atlas as an sRGB color
    // texture too, so the TCP2 port must do the same before lighting it.
    baseColor.rgb = SRGBToLinear(baseColor.rgb);
    float authoredLuma = dot(baseColor.rgb, vec3(0.2126, 0.7152, 0.0722));
    vec3 recolored = mainColor.rgb * mix(0.5, 1.3, clamp(authoredLuma, 0.0, 1.0));
    // The canonical dynamic-color atlas is the red Unity variant. Select its
    // red paint only; a generic chroma mask also recolors the blue-grey pegs.
    float sourcePaint = baseColor.r - max(baseColor.g, baseColor.b);
    float recolorMask = smoothstep(0.025, 0.12, sourcePaint) * recolorParams.x;
    // Recolor only chromatic paint. Unity box atlases also contain white face
    // panels, grey pegs and black gaps; multiplying those by mainColor turns
    // the whole prop into a dark silhouette.
    baseColor.rgb = mix(baseColor.rgb, recolored, recolorMask);
    baseColor.a *= mainColor.a;

    vec3 normal = normalize(v_worldNormal);
    vec3 lightDirection = normalize(-cc_mainLitDir.xyz);
    vec3 viewDirection = normalize(cc_cameraPos.xyz - v_worldPosition);
    float noL = max(dot(normal, lightDirection), 0.0);
    float noV = max(dot(normal, viewDirection), 0.0001);
    float halfLambert = dot(normal, lightDirection) * 0.5 + 0.5;
    float halfWidth = max(toonParams.y * 0.5, 0.0001);
    float ramp = smoothstep(toonParams.x - halfWidth, toonParams.x + halfWidth, halfLambert);

    vec3 direct;
    vec3 indirect;
    vec3 rimContribution;
    vec3 specular;
    if (unitySourceRigParams.x > 0.5) {
      vec3 sourceDirection0 = normalize(unityLightDirection0.xyz);
      vec3 sourceDirection1 = normalize(unityLightDirection1.xyz);
      vec3 sourceLight0 = unityLightColor0.rgb * unityLightIntensities.x;
      vec3 sourceLight1 = unityLightColor1.rgb * unityLightIntensities.y;
      float sourceNoL0 = max(dot(normal, sourceDirection0), 0.0);
      float sourceNoL1 = max(dot(normal, sourceDirection1), 0.0);
      float sourceWrapped0 = dot(normal, sourceDirection0) * 0.5 + 0.5;
      float sourceWrapped1 = dot(normal, sourceDirection1) * 0.5 + 0.5;
      float sourceRamp0 = smoothstep(toonParams.x - halfWidth,
        toonParams.x + halfWidth, sourceWrapped0);
      float sourceRamp1 = smoothstep(toonParams.x - halfWidth,
        toonParams.x + halfWidth, sourceWrapped1);

      // Unity forward-base uses the authored shadow/highlight ramp. Its
      // additional directional light starts from black and adds highlight.
      vec3 sourceMainTint = mix(shadowColor.rgb, highlightColor.rgb, sourceRamp0);
      direct = baseColor.rgb * sourceMainTint
        * mix(vec3(1.0), sourceLight0, toonParams.w);
      direct += baseColor.rgb * highlightColor.rgb * sourceRamp1 * sourceLight1;
      indirect = baseColor.rgb * unityTriLightAmbient(normal) * toonParams.z;

      float sourceRim = smoothstep(rimParams.x,
        max(rimParams.y, rimParams.x + 0.0001), 1.0 - noV);
      // TCP2 processes the fill directional light through the additional-light
      // loop, so its ramp/light mask contributes to the same rim emission.
      vec3 sourceRimLights = sourceLight0 * sourceRamp0
        + sourceLight1 * sourceRamp1;
      vec3 sourceRimMask = mix(vec3(1.0), sourceRimLights, rimParams.z);
      rimContribution = rimColor.rgb * sourceRim * sourceRimMask * rimParams.w;
      specular = tcp2Specular(sourceDirection0, viewDirection, normal)
        * specularColor.rgb * sourceLight0 * sourceNoL0 * specularParams.y;
      specular += tcp2Specular(sourceDirection1, viewDirection, normal)
        * specularColor.rgb * sourceLight1 * sourceNoL1 * specularParams.y;
    } else {
      vec3 mainLight = cc_mainLitColor.rgb * cc_mainLitColor.w;
      vec3 toonTint = mix(shadowColor.rgb, highlightColor.rgb, ramp);
      direct = baseColor.rgb * toonTint * mix(vec3(1.0), mainLight, toonParams.w);
      float hemisphere = normal.y * 0.5 + 0.5;
      vec3 ambient = mix(cc_ambientGround.rgb, cc_ambientSky.rgb, hemisphere) * cc_ambientSky.w;
      indirect = baseColor.rgb * ambient * toonParams.z;

      float rim = smoothstep(rimParams.x,
        max(rimParams.y, rimParams.x + 0.0001), 1.0 - noV);
      rimContribution = rimColor.rgb * rim
        * mix(vec3(1.0), mainLight * ramp, rimParams.z) * rimParams.w;
      specular = tcp2Specular(lightDirection, viewDirection, normal)
        * specularColor.rgb * mainLight * noL * specularParams.y;
    }
    // TCP2 can use a separate sRGB emission atlas; decode it independently
    // from the base map before applying the authored HDR emission color.
    vec3 emissionSample = SRGBToLinear(texture(emissiveMap, v_uv).rgb);
    vec3 emissionContribution = emissive.rgb * emissionSample;
    return CCFragOutput(vec4(direct + indirect + rimContribution + specular + emissionContribution, baseColor.a));
  }
}%
