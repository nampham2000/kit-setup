    "deploy.preview": "npm run deploy",
    "ai.sync": "npm run ai:sync",
    "ai.contract": "npm run ai:contract:verify",
    "memory.remember": "npm run memory:remember -- --memory-file <file.json>",
    "memory.doctor": "npm run memory:doctor -- --json",
    "memory.correct": "npm run memory:correct -- --id <memory-id> --scope <repo|global> --title <title> --content-file <file>",
